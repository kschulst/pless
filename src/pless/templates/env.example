# Copy to .env and fill in. Every value here should also live in your password
# manager — that is the source of truth; this file is a local cache that can be
# recreated. .env is git-ignored. Never commit it with real values.
#
# What each secret protects, and what happens if you lose it, is documented at
# https://kschulst.github.io/pless/reference/secrets/ — read it before setting
# up your password manager.
#
# The LUKS passphrase is deliberately NOT in this file. It is never written to
# disk anywhere, and it is the one secret that cannot be recovered.

# Hetzner Cloud API token (Read & Write), created in the Hetzner Cloud Console
# under Security -> API tokens. Only needed for the hetzner target.
HCLOUD_TOKEN=

# Paperless-ngx API token — only exists AFTER deployment. Create it in the
# Paperless web interface under your user profile.
PAPERLESS_API_TOKEN=

# Generated by `pless init --secrets`, or fill them in yourself.
# Save them in your password manager immediately.
PAPERLESS_ADMIN_PASSWORD=
PAPERLESS_SECRET_KEY=
POSTGRES_PASSWORD=

# Tailscale auth key, created in the Tailscale admin console under Keys.
# It decides which tailnet the machine joins.
TS_AUTHKEY=

# Off-site backup with restic. Lose RESTIC_PASSWORD and the backup is an
# encrypted blob nobody can open, including you.
RESTIC_PASSWORD=
B2_KEY_ID=
B2_APPLICATION_KEY=
