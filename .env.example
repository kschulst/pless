# Kopier til .env og fyll ut. ALLE verdier her skal også ligge i Bitwarden —
# Bitwarden er source of truth, denne fila er en lokal cache som kan gjenskapes.
# .env er gitignored. Commit aldri denne fila med verdier.

# Hetzner Cloud API-token (Read & Write), lages i console.hetzner.cloud
# -> prosjekt -> Security -> API tokens
HCLOUD_TOKEN=

# Paperless-ngx API-token — finnes først ETTER deploy (lages i Paperless-UI
# under profilen, eller av `pless paperless create-superuser`)
PAPERLESS_API_TOKEN=

# Genereres av `pless init --secrets` (eller fyll inn selv). Lagres i Bitwarden.
PAPERLESS_ADMIN_PASSWORD=
PAPERLESS_SECRET_KEY=
POSTGRES_PASSWORD=

# Restic offsite-backup til Backblaze B2 (fase: backup). Passphrase i Bitwarden —
# mister du den er offsite-backupen verdiløs.
RESTIC_PASSWORD=
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=

# Tailscale auth key (engangs/ephemeral, lages i Tailscale admin -> Keys)
# Brukes kun under bootstrap av serveren.
TS_AUTHKEY=
